<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitHub Copilot Network Connectivity Check</title>
    <style>
        :root {
            --color-bg: #0d1117;
            --color-surface: #161b22;
            --color-border: #30363d;
            --color-text: #e6edf3;
            --color-text-muted: #8b949e;
            --color-accent: #58a6ff;
            --color-success: #3fb950;
            --color-danger: #f85149;
            --color-warning: #d29922;
            --color-btn-bg: #21262d;
            --color-btn-hover: #30363d;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
            background: var(--color-bg);
            color: var(--color-text);
            line-height: 1.6;
            padding: 2rem;
            max-width: 900px;
            margin: 0 auto;
        }

        h1 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .subtitle {
            color: var(--color-text-muted);
            font-size: 0.875rem;
            margin-bottom: 2rem;
        }

        .config-section {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 6px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .config-section h2 {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .plan-selector {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }

        .plan-option {
            position: relative;
        }

        .plan-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .plan-option label {
            display: block;
            padding: 0.5rem 1.25rem;
            border: 1px solid var(--color-border);
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.875rem;
            transition: all 0.15s;
            user-select: none;
        }

        .plan-option label:hover {
            border-color: var(--color-accent);
        }

        .plan-option input:checked + label {
            border-color: var(--color-accent);
            background: rgba(88, 166, 255, 0.1);
            color: var(--color-accent);
        }

        .ghe-input {
            display: none;
            margin-top: 0.75rem;
        }

        .ghe-input.visible {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .ghe-input label {
            font-size: 0.875rem;
            color: var(--color-text-muted);
            white-space: nowrap;
        }

        .ghe-input input {
            background: var(--color-bg);
            border: 1px solid var(--color-border);
            border-radius: 6px;
            color: var(--color-text);
            padding: 0.4rem 0.75rem;
            font-size: 0.875rem;
            width: 200px;
        }

        .ghe-input input:focus {
            outline: none;
            border-color: var(--color-accent);
        }

        .actions {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        button {
            padding: 0.5rem 1.25rem;
            border-radius: 6px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            border: 1px solid var(--color-border);
            transition: all 0.15s;
        }

        .btn-primary {
            background: var(--color-accent);
            color: #ffffff;
            border-color: var(--color-accent);
        }

        .btn-primary:hover {
            filter: brightness(1.1);
        }

        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-secondary {
            background: var(--color-btn-bg);
            color: var(--color-text);
        }

        .btn-secondary:hover {
            background: var(--color-btn-hover);
        }

        .results-section {
            display: none;
            margin-top: 1.5rem;
        }

        .results-section.visible {
            display: block;
        }

        .summary-bar {
            display: flex;
            gap: 1.5rem;
            margin-bottom: 1rem;
            font-size: 0.875rem;
        }

        .summary-item {
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .progress-bar {
            height: 4px;
            background: var(--color-border);
            border-radius: 2px;
            margin-bottom: 1.5rem;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--color-accent);
            border-radius: 2px;
            transition: width 0.3s;
            width: 0%;
        }

        .endpoint-group {
            margin-bottom: 1.25rem;
        }

        .endpoint-group h3 {
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--color-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
            padding-bottom: 0.4rem;
            border-bottom: 1px solid var(--color-border);
        }

        .endpoint-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.4rem 0;
            font-size: 0.8125rem;
            font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        }

        .endpoint-url {
            color: var(--color-text);
            word-break: break-all;
        }

        .endpoint-purpose {
            color: var(--color-text-muted);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
            font-size: 0.75rem;
            margin-left: 0.5rem;
            flex-shrink: 0;
        }

        .status-badge {
            padding: 0.15rem 0.5rem;
            border-radius: 10px;
            font-size: 0.75rem;
            font-weight: 500;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
            flex-shrink: 0;
            margin-left: 0.75rem;
        }

        .status-pass { background: rgba(63, 185, 80, 0.15); color: var(--color-success); }
        .status-fail { background: rgba(248, 81, 73, 0.15); color: var(--color-danger); }
        .status-warn { background: rgba(210, 153, 34, 0.15); color: var(--color-warning); }
        .status-pending { background: rgba(139, 148, 158, 0.15); color: var(--color-text-muted); }

        .endpoint-left {
            display: flex;
            align-items: baseline;
            min-width: 0;
            flex: 1;
        }

        .script-section {
            margin-top: 1.5rem;
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 6px;
            padding: 1.5rem;
        }

        .script-section h3 {
            font-size: 0.9375rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .script-section p {
            font-size: 0.8125rem;
            color: var(--color-text-muted);
            margin-bottom: 1rem;
        }

        .script-tabs {
            display: flex;
            gap: 0;
            margin-bottom: 0;
        }

        .script-tab {
            padding: 0.4rem 1rem;
            font-size: 0.8125rem;
            background: var(--color-bg);
            border: 1px solid var(--color-border);
            color: var(--color-text-muted);
            cursor: pointer;
            border-bottom: none;
        }

        .script-tab:first-child { border-radius: 6px 0 0 0; }
        .script-tab:last-child { border-radius: 0 6px 0 0; }

        .script-tab.active {
            background: var(--color-surface);
            color: var(--color-text);
            border-bottom: 1px solid var(--color-surface);
        }

        .script-content {
            background: var(--color-bg);
            border: 1px solid var(--color-border);
            border-radius: 0 6px 6px 6px;
            padding: 1rem;
            font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
            font-size: 0.75rem;
            line-height: 1.5;
            overflow-x: auto;
            white-space: pre;
            max-height: 400px;
            overflow-y: auto;
        }

        .copy-btn {
            margin-top: 0.75rem;
            font-size: 0.8125rem;
            padding: 0.35rem 0.75rem;
        }

        .footer {
            margin-top: 2rem;
            padding-top: 1rem;
            border-top: 1px solid var(--color-border);
            font-size: 0.75rem;
            color: var(--color-text-muted);
        }

        .footer a {
            color: var(--color-accent);
            text-decoration: none;
        }

        @media (max-width: 600px) {
            body { padding: 1rem; }
            .plan-selector { flex-direction: column; }
            .endpoint-row { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
            .status-badge { margin-left: 0; }
        }
    </style>
</head>
<body>
    <h1>🔍 GitHub Copilot Network Connectivity Check</h1>
    <p class="subtitle">Verify that all required network endpoints for GitHub Copilot are accessible from your environment.</p>

    <div class="config-section">
        <h2>Select your Copilot plan</h2>
        <div class="plan-selector">
            <div class="plan-option">
                <input type="radio" name="plan" id="plan-individual" value="individual">
                <label for="plan-individual">Copilot Individual</label>
            </div>
            <div class="plan-option">
                <input type="radio" name="plan" id="plan-business" value="business" checked>
                <label for="plan-business">Copilot Business</label>
            </div>
            <div class="plan-option">
                <input type="radio" name="plan" id="plan-enterprise" value="enterprise">
                <label for="plan-enterprise">Copilot Enterprise</label>
            </div>
        </div>

        <div class="plan-selector" style="margin-top: 0.5rem;">
            <div class="plan-option">
                <input type="checkbox" id="opt-ghecom" value="ghecom">
                <label for="opt-ghecom">GHE.com (Data Residency)</label>
            </div>
        </div>

        <div class="ghe-input" id="ghe-subdomain-input">
            <label for="ghe-subdomain">GHE.com subdomain:</label>
            <input type="text" id="ghe-subdomain" placeholder="e.g. company">
        </div>

        <div class="actions" style="margin-top: 1rem;">
            <button class="btn-primary" id="btn-run" onclick="runCheck()">Run Connectivity Check</button>
            <button class="btn-secondary" id="btn-script" onclick="showScripts()">Generate Script</button>
        </div>
    </div>

    <div class="results-section" id="results-section">
        <div class="summary-bar" id="summary-bar">
            <div class="summary-item">✅ <span id="count-pass">0</span> Reachable</div>
            <div class="summary-item">❌ <span id="count-fail">0</span> Blocked</div>
            <div class="summary-item">⏳ <span id="count-pending">0</span> Pending</div>
        </div>
        <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
        <div id="results-container"></div>
    </div>

    <div class="script-section" id="script-section" style="display: none;">
        <h3>Download diagnostic script</h3>
        <p>For more accurate results, run this script on the affected machine. It tests each endpoint with curl (macOS/Linux) or Invoke-WebRequest (Windows).</p>
        <div class="script-tabs">
            <button class="script-tab active" onclick="switchTab('bash')">Bash (macOS/Linux)</button>
            <button class="script-tab" onclick="switchTab('powershell')">PowerShell (Windows)</button>
        </div>
        <div class="script-content" id="script-content"></div>
        <button class="btn-secondary copy-btn" onclick="copyScript()">📋 Copy to clipboard</button>
    </div>

    <div class="footer">
        <p>Reference: <a href="https://docs.github.com/en/copilot/reference/copilot-allowlist-reference" target="_blank">GitHub Copilot Allowlist Reference</a></p>
        <p style="margin-top: 0.25rem;">Note: Browser-based checks use <code>fetch()</code> with <code>no-cors</code> mode. Results indicate network reachability, not full service health. Use the generated script for more precise diagnostics.</p>
    </div>

    <script>
        const ENDPOINTS = {
            common: [
                { url: 'https://github.com/login', purpose: 'Authentication' },
                { url: 'https://api.github.com/user', purpose: 'User Management' },
                { url: 'https://api.github.com/copilot_internal/', purpose: 'User Management' },
                { url: 'https://copilot-telemetry.githubusercontent.com/telemetry', purpose: 'Telemetry' },
                { url: 'https://collector.github.com', purpose: 'Analytics telemetry' },
                { url: 'https://default.exp-tas.com', purpose: 'Telemetry' },
                { url: 'https://copilot-proxy.githubusercontent.com', purpose: 'Copilot API' },
                { url: 'https://origin-tracker.githubusercontent.com', purpose: 'Copilot API' },
            ],
            individual: [
                { url: 'https://individual.githubcopilot.com', purpose: 'Individual plan API' },
            ],
            business: [
                { url: 'https://business.githubcopilot.com', purpose: 'Business plan API' },
            ],
            enterprise: [
                { url: 'https://enterprise.githubcopilot.com', purpose: 'Enterprise plan API' },
            ],
            ghecom: [
                // dynamically populated based on subdomain
            ],
            metrics: [
                { url: 'https://copilot-reports-eastus.b01.azurefd.net', purpose: 'Usage metrics reports' },
            ]
        };

        let currentTab = 'bash';
        let currentResults = [];

        // GHE.com checkbox toggle
        document.getElementById('opt-ghecom').addEventListener('change', function() {
            document.getElementById('ghe-subdomain-input').classList.toggle('visible', this.checked);
        });

        function getSelectedPlan() {
            return document.querySelector('input[name="plan"]:checked').value;
        }

        function getEndpointsForPlan() {
            const plan = getSelectedPlan();
            const isGhe = document.getElementById('opt-ghecom').checked;
            const subdomain = document.getElementById('ghe-subdomain').value.trim();

            const groups = [
                { name: 'Common (All Plans)', endpoints: [...ENDPOINTS.common] },
            ];

            if (plan === 'individual') {
                groups.push({ name: 'Copilot Individual', endpoints: [...ENDPOINTS.individual] });
            } else if (plan === 'business') {
                groups.push({ name: 'Copilot Business', endpoints: [...ENDPOINTS.business] });
            } else if (plan === 'enterprise') {
                groups.push({ name: 'Copilot Enterprise', endpoints: [...ENDPOINTS.enterprise] });
            }

            if (isGhe && subdomain) {
                groups.push({
                    name: 'GHE.com (Data Residency)',
                    endpoints: [
                        { url: `https://${subdomain}.ghe.com`, purpose: 'GHE.com portal' },
                    ]
                });
            }

            groups.push({ name: 'Metrics & Reporting', endpoints: [...ENDPOINTS.metrics] });

            return groups;
        }

        async function checkEndpoint(url) {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), 8000);

            try {
                const start = performance.now();
                await fetch(url, {
                    mode: 'no-cors',
                    signal: controller.signal,
                    cache: 'no-store',
                });
                const elapsed = Math.round(performance.now() - start);
                clearTimeout(timeout);
                return { status: 'pass', time: elapsed };
            } catch (err) {
                clearTimeout(timeout);
                if (err.name === 'AbortError') {
                    return { status: 'fail', error: 'Timeout (8s)' };
                }
                return { status: 'fail', error: 'Network error' };
            }
        }

        async function runCheck() {
            const btn = document.getElementById('btn-run');
            btn.disabled = true;
            btn.textContent = 'Checking...';

            const groups = getEndpointsForPlan();
            const resultsSection = document.getElementById('results-section');
            const container = document.getElementById('results-container');
            resultsSection.classList.add('visible');
            container.innerHTML = '';
            currentResults = [];

            let totalEndpoints = groups.reduce((sum, g) => sum + g.endpoints.length, 0);
            let completed = 0;
            let passCount = 0;
            let failCount = 0;

            document.getElementById('count-pass').textContent = '0';
            document.getElementById('count-fail').textContent = '0';
            document.getElementById('count-pending').textContent = totalEndpoints;
            document.getElementById('progress-fill').style.width = '0%';

            for (const group of groups) {
                const groupDiv = document.createElement('div');
                groupDiv.className = 'endpoint-group';
                groupDiv.innerHTML = `<h3>${group.name}</h3>`;

                const rows = [];
                for (const ep of group.endpoints) {
                    const row = document.createElement('div');
                    row.className = 'endpoint-row';
                    row.innerHTML = `
                        <div class="endpoint-left">
                            <span class="endpoint-url">${ep.url}</span>
                            <span class="endpoint-purpose">${ep.purpose}</span>
                        </div>
                        <span class="status-badge status-pending">checking...</span>
                    `;
                    groupDiv.appendChild(row);
                    rows.push({ row, ep });
                }

                container.appendChild(groupDiv);

                // Check all endpoints in this group in parallel
                const promises = rows.map(async ({ row, ep }) => {
                    const result = await checkEndpoint(ep.url);
                    const badge = row.querySelector('.status-badge');

                    if (result.status === 'pass') {
                        badge.className = 'status-badge status-pass';
                        badge.textContent = `✓ ${result.time}ms`;
                        passCount++;
                    } else {
                        badge.className = 'status-badge status-fail';
                        badge.textContent = `✗ ${result.error}`;
                        failCount++;
                    }

                    currentResults.push({
                        url: ep.url,
                        purpose: ep.purpose,
                        group: group.name,
                        ...result
                    });

                    completed++;
                    document.getElementById('count-pass').textContent = passCount;
                    document.getElementById('count-fail').textContent = failCount;
                    document.getElementById('count-pending').textContent = totalEndpoints - completed;
                    document.getElementById('progress-fill').style.width = `${(completed / totalEndpoints) * 100}%`;
                });

                await Promise.all(promises);
            }

            btn.disabled = false;
            btn.textContent = 'Run Connectivity Check';
        }

        function generateBashScript() {
            const groups = getEndpointsForPlan();
            let script = `#!/bin/bash
# GitHub Copilot Network Connectivity Check
# Plan: ${getSelectedPlan()}
# Generated: ${new Date().toISOString()}

echo "======================================"
echo " GitHub Copilot Network Check"
echo " Plan: ${getSelectedPlan()}"
echo "======================================"
echo ""

PASS=0
FAIL=0

check_url() {
    local url="$1"
    local purpose="$2"
    local http_code
    http_code=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 5 --max-time 10 "$url" 2>/dev/null)
    if [ $? -eq 0 ] && [ "$http_code" != "000" ]; then
        echo "  ✓ PASS ($http_code) - $url  ($purpose)"
        PASS=$((PASS + 1))
    else
        echo "  ✗ FAIL       - $url  ($purpose)"
        FAIL=$((FAIL + 1))
    fi
}

`;

            for (const group of groups) {
                script += `echo "── ${group.name} ──"\n`;
                for (const ep of group.endpoints) {
                    script += `check_url "${ep.url}" "${ep.purpose}"\n`;
                }
                script += `echo ""\n`;
            }

            script += `
echo "======================================"
echo " Results: $PASS passed, $FAIL failed"
echo "======================================"

if [ $FAIL -gt 0 ]; then
    echo ""
    echo "Some endpoints are not reachable."
    echo "Please check your firewall/proxy settings."
    echo "Reference: https://docs.github.com/en/copilot/reference/copilot-allowlist-reference"
    exit 1
fi
`;
            return script;
        }

        function generatePowerShellScript() {
            const groups = getEndpointsForPlan();
            let script = `# GitHub Copilot Network Connectivity Check
# Plan: ${getSelectedPlan()}
# Generated: ${new Date().toISOString()}

Write-Host "======================================"
Write-Host " GitHub Copilot Network Check"
Write-Host " Plan: ${getSelectedPlan()}"
Write-Host "======================================"
Write-Host ""

$pass = 0
$fail = 0

function Test-Endpoint {
    param([string]$Url, [string]$Purpose)
    try {
        $response = Invoke-WebRequest -Uri $Url -UseBasicParsing -TimeoutSec 10 -ErrorAction Stop
        Write-Host "  ✓ PASS ($($response.StatusCode)) - $Url  ($Purpose)" -ForegroundColor Green
        $script:pass++
    } catch {
        try {
            # Some endpoints return errors but are still reachable
            $statusCode = $_.Exception.Response.StatusCode.value__
            if ($statusCode) {
                Write-Host "  ✓ PASS ($statusCode) - $Url  ($Purpose)" -ForegroundColor Green
                $script:pass++
            } else {
                Write-Host "  ✗ FAIL       - $Url  ($Purpose)" -ForegroundColor Red
                $script:fail++
            }
        } catch {
            Write-Host "  ✗ FAIL       - $Url  ($Purpose)" -ForegroundColor Red
            $script:fail++
        }
    }
}

`;

            for (const group of groups) {
                script += `Write-Host "── ${group.name} ──"\n`;
                for (const ep of group.endpoints) {
                    script += `Test-Endpoint -Url "${ep.url}" -Purpose "${ep.purpose}"\n`;
                }
                script += `Write-Host ""\n`;
            }

            script += `
Write-Host "======================================"
Write-Host " Results: $pass passed, $fail failed"
Write-Host "======================================"

if ($fail -gt 0) {
    Write-Host ""
    Write-Host "Some endpoints are not reachable." -ForegroundColor Yellow
    Write-Host "Please check your firewall/proxy settings."
    Write-Host "Reference: https://docs.github.com/en/copilot/reference/copilot-allowlist-reference"
}
`;
            return script;
        }

        function showScripts() {
            const section = document.getElementById('script-section');
            section.style.display = 'block';
            switchTab(currentTab);
            section.scrollIntoView({ behavior: 'smooth' });
        }

        function switchTab(tab) {
            currentTab = tab;
            document.querySelectorAll('.script-tab').forEach(t => t.classList.remove('active'));
            event.target?.classList.add('active') ||
                document.querySelector(`.script-tab:${tab === 'bash' ? 'first' : 'last'}-child`).classList.add('active');

            const content = document.getElementById('script-content');
            content.textContent = tab === 'bash' ? generateBashScript() : generatePowerShellScript();
        }

        function copyScript() {
            const content = document.getElementById('script-content').textContent;
            navigator.clipboard.writeText(content).then(() => {
                const btn = document.querySelector('.copy-btn');
                const orig = btn.textContent;
                btn.textContent = '✓ Copied!';
                setTimeout(() => btn.textContent = orig, 2000);
            });
        }
    </script>
</body>
</html>
